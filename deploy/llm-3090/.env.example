# LLM stack config for classifier-3090.
# Copy to .env and fill in:  cp .env.example .env   (.env is gitignored)

# API key for the LLM service (Bearer auth). Reuse the same key as the 5090 box
# if clients should hit either interchangeably.
API_KEY=

# Host directory mounted into the container as /models.
MODEL_DIR=/home/pawel/models

# Model + MTP draft download URLs — used by entrypoint.sh ONLY if the files are
# missing under MODEL_DIR. Preferred path is to scp both GGUFs from the 5090 box
# (they already exist there), which avoids a 17 GB re-download. These URLs are
# the Unsloth A4B repo by analogy to the 31B repo — verify before relying on them.
HF_MODEL_URL=https://huggingface.co/unsloth/gemma-4-26B-A4B-it-GGUF/resolve/main/gemma-4-26B-A4B-it-UD-Q4_K_XL.gguf
HF_DRAFT_URL=https://huggingface.co/unsloth/gemma-4-26B-A4B-it-GGUF/resolve/main/MTP/gemma-4-26B-A4B-it-F16-MTP.gguf
